entrypoint = "bot.js"
run = ["sh", "-c", "npm install && node bot.js"]
modules = ["nodejs-18", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["jdk", "glib", "nss", "nspr", "atk", "cups", "libdrm", "gtk3", "pango", "cairo", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "mesa", "expat", "dbus", "alsa-lib", "at-spi2-atk", "at-spi2-core"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow]]
name = "Discord Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node start.js"

[agent]
expertMode = true

[[ports]]
localPort = 2010
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 41001
externalPort = 3002

[[ports]]
localPort = 46167
externalPort = 3001
